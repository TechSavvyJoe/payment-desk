{
  "manifest_version": 3,
  "name": "Payment Desk Companion",
  "version": "1.0.0",
  "description": "Capture a vehicle's advertised price and stock reference, review the details, and start a Payment Desk estimate.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Payment Desk Companion",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": { "open-payment-desk": { "description": "Open a blank Payment Desk estimate" } },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
