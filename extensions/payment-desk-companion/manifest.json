{
  "manifest_version": 3,
  "name": "Payment Desk Companion",
  "version": "1.4.0",
  "minimum_chrome_version": "116",
  "description": "Use the Payment Desk worksheet in Chrome's side panel, capture listings, and refresh a dealership's public inventory.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "alarms", "offscreen", "webRequest"],
  "optional_host_permissions": ["https://*/*"],
  "externally_connectable": { "matches": ["https://desking.mysoldlog.com/*"] },
  "action": {
    "default_title": "Open Payment Desk side panel",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "commands": { "open-payment-desk": { "description": "Open Payment Desk side panel" } },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'self'; connect-src https:; img-src 'self' data: https:" }
}
